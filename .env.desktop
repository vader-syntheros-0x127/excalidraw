# STRL: env for the desktop build (`vite build --mode desktop`).
# The backend is deferred, so we intentionally DO NOT bake in any of
# excalidraw.com's backend identifiers (firebase, websocket/collab server,
# AI backend, library, Plus, tracking). Everything here is empty so the
# packaged app ships clean and fully local.
MODE=production

VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=
VITE_APP_WS_SERVER_URL=
VITE_APP_FIREBASE_CONFIG=
VITE_APP_AI_BACKEND=
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=
VITE_APP_PLUS_EXPORT_PUBLIC_KEY=

VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_PWA=true

# STRL: load the bundled fonts locally (no excalidraw.com CDN / Google Fonts
# phone-home on launch) and let main.ts enforce a strict app:// CSP.
VITE_APP_DESKTOP=true

VITE_APP_ENABLE_ESLINT=false
