# STRL: host-side LAN serve settings — TEMPLATE.
# Copy to .strl-serve.env (gitignored) and set a real token:
#   cp .strl-serve.env.example .strl-serve.env
#   sed -i "s/REPLACE_ME/$(openssl rand -hex 24)/" .strl-serve.env
# Then: scripts/strl-serve.sh

# --- MCP server over Streamable HTTP (remote dev machines connect as clients) ---
STRL_MCP_TRANSPORT=http
# 0.0.0.0 exposes on the LAN; a token is REQUIRED for any non-loopback bind.
STRL_MCP_HTTP_HOST=0.0.0.0
STRL_MCP_HTTP_PORT=7337
STRL_MCP_HTTP_PATH=/mcp
STRL_MCP_HTTP_TOKEN=REPLACE_ME
# Comma list of Host: values remote clients use (DNS-rebinding allowlist).
# Include this host's LAN IP:PORT, e.g. 192.168.1.50:7337,localhost:7337
STRL_MCP_HTTP_ALLOWED_HOSTS=REPLACE_WITH_LAN_IP:7337,localhost:7337,127.0.0.1:7337
# Shared canvas workdir all remote agents draw into.
STRL_MCP_WORKDIR=/abs/path/to/strl-excalidraw/diagrams
STRL_MCP_ACTIVE_FILE=scene.excalidraw

# --- Static web preview served on the LAN ---
STRL_WEB_BIND=0.0.0.0
STRL_WEB_PORT=8080
