# pnpm config (migrated from yarn)
save-exact=true

# This Electron monorepo relies on a flat/hoisted node_modules (phantom deps:
# excalidraw-app uses `vite` without declaring it; electron-builder needs a flat tree).
node-linker=hoisted

# Don't fail the build on peer-dependency mismatches (mirrors yarn 1 behaviour).
strict-peer-dependencies=false

# Link internal workspace packages by matching version (pnpm 10 defaults this off;
# our packages cross-reference each other as plain "0.18.0", not workspace:* ).
link-workspace-packages=true

# Supply-chain: refuse dependency versions published less than 24h ago (anti-malware cooldown).
minimum-release-age=1440
