{
  "private": true,
  "name": "strl-ideate-monorepo",
  "packageManager": "pnpm@10.34.1",
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@eslint/js": "9.39.4",
    "@excalidraw/prettier-config": "1.0.2",
    "@types/chai": "4.3.0",
    "@types/jest": "27.4.0",
    "@types/lodash.throttle": "4.1.9",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "4.1.7",
    "chai": "4.3.6",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "http-server": "14.1.1",
    "husky": "7.0.4",
    "jsdom": "29.1.1",
    "lint-staged": "12.3.7",
    "pepjs": "0.5.3",
    "prettier": "2.6.2",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.14",
    "vite-plugin-checker": "0.14.1",
    "vite-plugin-ejs": "1.7.0",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.7",
    "vitest-canvas-mock": "1.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": ".",
  "prettier": "@excalidraw/prettier-config",
  "scripts": {
    "build:app:docker": "pnpm -C ./excalidraw-app build:app:docker",
    "build:app": "pnpm -C ./excalidraw-app build:app",
    "build:common": "pnpm -C ./packages/common build:esm",
    "build:element": "pnpm -C ./packages/element build:esm",
    "build:excalidraw": "pnpm -C ./packages/excalidraw build:esm",
    "build:math": "pnpm -C ./packages/math build:esm",
    "build:fractional-indexing": "pnpm -C ./packages/fractional-indexing build:esm",
    "build:packages": "pnpm build:common && pnpm build:fractional-indexing && pnpm build:math && pnpm build:element && pnpm build:excalidraw",
    "build:version": "pnpm -C ./excalidraw-app build:version",
    "build": "pnpm -C ./excalidraw-app build",
    "build:preview": "pnpm -C ./excalidraw-app build:preview",
    "start": "pnpm -C ./excalidraw-app start",
    "start:production": "pnpm -C ./excalidraw-app start:production",
    "start:example": "pnpm build:packages && pnpm -C ./examples/with-script-in-browser start",
    "test:all": "pnpm test:typecheck && pnpm test:code && pnpm test:other && pnpm test:app --watch=false",
    "test:app": "vitest",
    "test:code": "eslint --max-warnings=0 .",
    "test:other": "pnpm prettier --list-different",
    "test:typecheck": "tsc",
    "test:update": "pnpm test:app --update --watch=false",
    "test": "pnpm test:app",
    "test:coverage": "vitest --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:ui": "pnpm test --ui --coverage.enabled=true",
    "fix:code": "pnpm test:code --fix",
    "fix:other": "pnpm prettier --write",
    "fix": "pnpm fix:other && pnpm fix:code",
    "locales-coverage": "node scripts/build-locales-coverage.js",
    "locales-coverage:description": "node scripts/locales-coverage-description.js",
    "prepare": "husky install",
    "prettier": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.prettierignore",
    "release": "node scripts/release.js",
    "release:test": "node scripts/release.js --tag=test",
    "release:next": "node scripts/release.js --tag=next",
    "release:latest": "node scripts/release.js --tag=latest",
    "rm:build": "rimraf --glob excalidraw-app/build excalidraw-app/dist excalidraw-app/dev-dist packages/*/dist packages/*/build examples/*/build examples/*/dist",
    "rm:node_modules": "rimraf --glob node_modules excalidraw-app/node_modules packages/*/node_modules",
    "clean-install": "pnpm rm:node_modules && pnpm install"
  },
  "pnpm": {
    "overrides": {
      "strip-ansi": "6.0.1",
      "immutable@4": "4.3.8",
      "immutable@5": "5.1.5",
      "lodash-es": "4.18.1",
      "mermaid": "11.15.0",
      "ajv@8": "8.18.0",
      "fast-uri": "3.1.2",
      "qs": "6.15.2",
      "brace-expansion@1": "1.1.13",
      "minimatch@5": "5.1.8",
      "picomatch@2": "2.3.2",
      "postcss": "8.5.10",
      "rollup": "4.59.0",
      "nanoid": "5.0.9",
      "uuid": "11.1.1",
      "esbuild": "0.28.0",
      "tar-fs@2": "2.1.4",
      "ws@8": "8.21.0",
      "serialize-javascript": "7.0.5",
      "webpack": "5.107.2",
      "yaml@1": "1.10.3",
      "js-yaml@4": "4.1.1",
      "js-yaml@3": "3.14.2",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.0",
      "@tootallnate/once@2": "2.0.1",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "jotai": "2.20.0",
      "eslint-plugin-react": "7.37.5",
      "workbox-build": "7.4.1",
      "workbox-window": "7.4.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
